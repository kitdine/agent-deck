    "interactions": "(async () => {\n  const wait = () => new Promise(r => requestAnimationFrame(() => requestAnimationFrame(r)));\n  const assertions = [];\n  const check = (name, pass) => assertions.push({name, passed:!!pass});\n  const select = document.querySelector('[data-serving-state]');\n  const phase = value => { select.value=value; select.dispatchEvent(new Event('change',{bubbles:true})); };\n  phase('failed'); await wait();\n  const before = document.querySelector('.hero')?.innerText;\n  document.querySelector('[data-serving-retry]').click(); await wait();\n  check('retry_preserves_data', document.querySelector('[data-serving-status]')?.dataset.phase==='rebuilding' && document.querySelector('.hero')?.innerText===before);\n  document.querySelector('.segmented.clients button:nth-child(2)').click();\n  document.querySelector('.segmented.periods button:nth-child(3)').click(); await wait();\n  const focused = document.querySelector('.segmented.clients button:nth-child(2)'); focused.focus();\n  document.querySelector('[data-serving-publish]').click(); await wait();\n  check('publication_preserves_filters', document.querySelector('.segmented.clients [aria-selected=\"true\"]')===focused && document.querySelector('.segmented.periods button:nth-child(3)').getAttribute('aria-selected')==='true');\n  check('publication_preserves_focus',document.activeElement===focused);\n  check('publication_updates_atomically',document.querySelector('[data-serving-status]')?.dataset.phase==='memory' && document.querySelector('.popover')?.dataset.servingSnapshot==='current');\n  phase('rebuilding'); await wait();\n  document.querySelector('.menubar-item').click(); await wait();\n  check('close_detaches_surface',!document.querySelector('.popover'));\n  document.querySelector('[data-serving-publish]').click(); await wait();\n  document.querySelector('.menubar-item').click(); await wait();\n  check('reopen_uses_current_publication',document.querySelector('[data-serving-status]')?.dataset.phase==='memory' && !!document.querySelector('.hero'));\n  phase('midnight'); await wait();\n  check('midnight_today_unavailable',document.querySelector('.hero strong')?.textContent.trim()==='—');\n  document.querySelector('.segmented.periods button:nth-child(2)').click(); await wait();\n  check('midnight_historical_period_available',document.querySelector('.hero strong')?.textContent.trim()!=='—');\n  phase('invalid'); await wait();\n  check('invalid_cache_never_shows_numbers',!document.querySelector('.hero') && document.querySelector('.menubar-item strong')?.textContent==='—');\n  return {kind:'browser_interactions',language:new URLSearchParams(location.search).get('lang'),assertions,passed:assertions.every(x=>x.passed)};\n})()\n",
