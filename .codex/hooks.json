{
  "description": "Scope Beads Stop diagnostics to the current session; keep full audits explicit.",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/beads-consistency.py\" --runtime codex",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"$(git rev-parse --show-toplevel)/scripts/hooks/beads-consistency.py\" --runtime codex",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
