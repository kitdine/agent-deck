<plist version="1.0">
<dict>
    <key>CFBundleDisplayName</key>
    <string>AgentDeck</string>
    <key>AgentDeckAppGroupIdentifier</key>
    <string>$(AGENTDECK_APP_GROUP)</string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
