MACOSX_DEPLOYMENT_TARGET = 26.0
SWIFT_VERSION = 6.0
PRODUCT_BUNDLE_IDENTIFIER = com.kitdine.agentdeck
AGENTDECK_APP_GROUP = N2FZ2FNRTU.group.com.kitdine.agentdeck

// Distribution inputs. The defaults are what an unsigned local build and an
// isolated distribution test need; a real release overrides them on the
// xcodebuild invocation and never by editing this file.
AGENTDECK_MARKETING_VERSION = 0.5.0
// Local and isolated-test default only. A manually dispatched release preflight
// assigns the distributable candidate build and injects it without editing this file.
AGENTDECK_PROJECT_VERSION = 1
// `-` is the ad-hoc identity. Release signing is performed by
// scripts/package-macos-app.sh, which signs nested code inside-out with an
// explicit identity; the build itself stays signable without any credential.
AGENTDECK_CODE_SIGN_IDENTITY = -
AGENTDECK_DEVELOPMENT_TEAM = N2FZ2FNRTU
